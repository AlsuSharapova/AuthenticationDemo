@using AuthenticationDemo.ViewModels;
@model ConfirmEmailViewModel;
@{
    ViewData["Title"] = "Confirm Email";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}

<div class="account-container">
    <div class="account-box">
        <h2 class="text-center mb-4">Confirm Email</h2>
        <p class="text-center text-muted">We sent a code to your email. Enter it below.</p>

        <form asp-action="ConfirmEmail" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="Purpose" />

            <div class="mb-3">
                <label asp-for="Code" class="form-label">Confirmation Code</label>
                <input asp-for="Code" class="form-control" maxlength="6" autocomplete="one-time-code" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>

            <input type="submit" value="Confirm" class="btn btn-success w-100 p-2" />

            <div class="text-center mt-2">
                <a asp-controller="Account" asp-action="Register" class="text-decoration-none">Back</a>
            </div>

            <div class="text-center mt-3">
                <span id="timerText" style="@(Model.SecondsRemaining <= 0 ? "display:none;" : "")">
                    Resend code in <span id="countdown">@Model.SecondsRemaining</span> sec.
                </span>
                <button type="button" id="resendBtn" class="btn btn-link"
                        style="@(Model.SecondsRemaining <= 0 ? "" : "display:none;")" onclick="resendCode()">
                    Resend code
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
    <script>
        let seconds = @Model.SecondsRemaining;
        const countdownEl = document.getElementById("countdown");
        const timerText = document.getElementById("timerText");
        const resendBtn = document.getElementById("resendBtn");

        let interval;
        if(seconds > 0){
            interval = setInterval(() => {
                seconds--;
                countdownEl.textContent = seconds;

                if (seconds <= 0) {
                    clearInterval(interval);
                    timerText.style.display = "none";
                    resendBtn.style.display = "inline-block";
                }
            }, 1000);
        }
        function resendCode() {
            fetch('@Url.Action("ResendCode", "Account")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ userId: '@Model.UserId', purpose: '@Model.Purpose' })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert("Code has been resent!");
                    seconds = 60;
                    timerText.style.display = "inline";
                    resendBtn.style.display = "none";
                    const newInterval = setInterval(() => {
                        seconds--;
                        countdownEl.textContent = seconds;
                        if (seconds <= 0) {
                            clearInterval(newInterval);
                            timerText.style.display = "none";
                            resendBtn.style.display = "inline-block";
                        }
                    }, 1000);
                } else {
                    alert("Could not resend code. Please try again later.");
                }
            });
        }
    </script>
}
